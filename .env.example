# QWEN模型配置示例 / Qwen Model Configuration Example
## 端点与模型：请根据您的密钥所属区域选择端点
## - 中国区（北京）：https://dashscope.aliyuncs.com/compatible-mode/v1
## - 国际站（新加坡）：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=YOUR_API_KEY
## 推荐稳定商用模型：qwen-plus；其他可用模型: qwen-max, qwen-turbo
QWEN_MODEL_NAME=qwen-plus

# 兼容OpenAI的配置（CrewAI需要） / OpenAI-Compatible Configuration (Required by CrewAI)
## CrewAI/LiteLLM将通过OpenAI兼容接口访问：可与QWEN_API_*保持一致
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=YOUR_API_KEY
## 也可设置 DASHSCOPE_API_KEY 以兼容官方SDK示例
DASHSCOPE_API_KEY=YOUR_API_KEY

# Materials Project API配置（可选） / Materials Project API Configuration (Optional)
MATERIALS_PROJECT_API_KEY=YOUR_MATERIALS_PROJECT_API_KEY

# PubChem API配置（可选） / PubChem API Configuration (Optional)
PUBCHEM_API_KEY=YOUR_PUBCHEM_API_KEY

# MolPort API配置（可选，用于商业可获得性查询） / MolPort API Configuration (Optional, for commercial availability queries)
MOLPORT_API_KEY=YOUR_MOLPORT_API_KEY

# PostgreSQL 向量数据库配置（可选，用于 SFT 向量检索） / PostgreSQL Vector DB Configuration (Optional, for SFT vector search)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_database
PG_USER=your_username
PG_PASSWORD=your_password

# 图数据库配置（可选，用于阿里云 GDB / Neo4j 类图谱查询） / Graph DB Configuration (Optional, for Aliyun GDB / Neo4j-like graph queries)
GDB_HOST=localhost
GDB_PORT=3734
GDB_USERNAME=your_gdb_username
GDB_PASSWORD=your_gdb_password

# 模型参数配置 / Model Parameter Configuration
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=8196

# 特定智能体的温度配置 / Temperature Configuration for Specific Agents
# 材料设计专家使用较高温度以增加多样性 / Material Design Expert Uses Higher Temperature to Increase Diversity
MATERIAL_DESIGNER_TEMPERATURE=0.8

# 评估专家使用较低温度以确保准确性 / Evaluation Experts Use Lower Temperature to Ensure Accuracy
EXPERT_A_TEMPERATURE=0.3
EXPERT_B_TEMPERATURE=0.3
EXPERT_C_TEMPERATURE=0.3

# 最终验证专家使用适中温度 / Final Validator Uses Moderate Temperature
FINAL_VALIDATOR_TEMPERATURE=0.5

# 其他专家使用默认评估温度 / Other Experts Use Default Evaluation Temperature
MECHANISM_EXPERT_TEMPERATURE=0.3
SYNTHESIS_EXPERT_TEMPERATURE=0.3
OPERATION_SUGGESTING_TEMPERATURE=0.3
LITERATURE_PROCESSOR_TEMPERATURE=0.3

# 迭代设计配置 / Iterative Design Configuration
MAX_DESIGN_ITERATIONS=3
MIN_ACCEPTABLE_SCORE=7.0

# 一致性分析配置 / Consistency Analysis Configuration
HIGH_CONSISTENCY_THRESHOLD=1.0
MEDIUM_CONSISTENCY_THRESHOLD=2.0

# 语言配置 / Language Configuration
# 可选值 / Available options: zh (中文), en (English)
LANGUAGE=zh

# 其他配置 / Other Configuration
VERBOSE=True

# 工具调用配置 / Tool Calling Configuration
# 建议启用工具调用以获取最佳性能 / Enable tool calling for best performance
ENABLE_TOOLS=true

# EAS模型配置（可选） / EAS Model Configuration (Optional)
EAS_ENDPOINT=your-eas-endpoint
EAS_TOKEN=your-eas-token
EAS_MODEL_NAME=your-model-name