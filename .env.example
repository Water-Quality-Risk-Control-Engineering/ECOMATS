# Qwen Model Configuration Example
## Endpoint & Model: Choose endpoint based on your API key region
## - China (Beijing): https://dashscope.aliyuncs.com/compatible-mode/v1
## - International (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=YOUR_API_KEY
## Recommended stable model: qwen-plus; Other available models: qwen-max, qwen-turbo
QWEN_MODEL_NAME=qwen-plus

# OpenAI-Compatible Configuration (Required by CrewAI)
## CrewAI/LiteLLM accesses via OpenAI-compatible interface; can match QWEN_API_*
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=YOUR_API_KEY
## You may also set DASHSCOPE_API_KEY for official SDK compatibility
DASHSCOPE_API_KEY=YOUR_API_KEY

# Materials Project API Configuration (Optional)
MATERIALS_PROJECT_API_KEY=YOUR_MATERIALS_PROJECT_API_KEY

# PubChem API Configuration (Optional)
PUBCHEM_API_KEY=YOUR_PUBCHEM_API_KEY

# MolPort API Configuration (Optional, for commercial availability queries)
MOLPORT_API_KEY=YOUR_MOLPORT_API_KEY

# PostgreSQL Vector DB Configuration (Optional, for SFT vector search)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_database
PG_USER=your_username
PG_PASSWORD=your_password

# Graph DB Configuration (Optional, for Aliyun GDB / Neo4j-like graph queries)
GDB_HOST=localhost
GDB_PORT=3734
GDB_USERNAME=your_gdb_username
GDB_PASSWORD=your_gdb_password

# Model Parameter Configuration
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=8196

# Temperature Configuration for Specific Agents
# Material Design Expert Uses Higher Temperature to Increase Diversity
MATERIAL_DESIGNER_TEMPERATURE=0.8

# Evaluation Experts Use Lower Temperature to Ensure Accuracy
EXPERT_A_TEMPERATURE=0.3
EXPERT_B_TEMPERATURE=0.3
EXPERT_C_TEMPERATURE=0.3

# Final Validator Uses Moderate Temperature
FINAL_VALIDATOR_TEMPERATURE=0.5

# Other Experts Use Default Evaluation Temperature
MECHANISM_EXPERT_TEMPERATURE=0.3
SYNTHESIS_EXPERT_TEMPERATURE=0.3
OPERATION_SUGGESTING_TEMPERATURE=0.3
LITERATURE_PROCESSOR_TEMPERATURE=0.3

# Iterative Design Configuration
MAX_DESIGN_ITERATIONS=3
MIN_ACCEPTABLE_SCORE=7.0

# Consistency Analysis Configuration
HIGH_CONSISTENCY_THRESHOLD=1.0
MEDIUM_CONSISTENCY_THRESHOLD=2.0

# Language Configuration
# Available options: zh (Chinese), en (English)
LANGUAGE=zh

# Other Configuration
VERBOSE=True

# Tool Calling Configuration
# Enable tool calling for best performance
ENABLE_TOOLS=true

# EAS Model Configuration (Optional)
EAS_ENDPOINT=your-eas-endpoint
EAS_TOKEN=your-eas-token
EAS_MODEL_NAME=your-model-name